PORT=5001
JWT_SECRET=replace-this-with-a-long-random-string

# --- CORS ---------------------------------------------------------------
# Which frontend origin(s) are allowed to call this API and open a
# websocket connection. Comma-separate multiple origins (e.g. staging +
# production). Defaults to the local Vite dev server if left blank.
FRONTEND_ORIGIN=http://localhost:5174

# --- Outgoing email (welcome email on sign-up) ------------------------
# Optional. If left blank, Flowboard just logs the welcome email to the
# backend console instead of sending it — registration still works fine
# without this, which is handy for local dev.
#
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your
# address, SMTP_PASS=a 16-character App Password (Google Account →
# Security → 2-Step Verification → App passwords) — your normal Gmail
# password won't work here.
# For a free disposable inbox to test with instead, see https://ethereal.email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
